    {
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": "24f9440556f78033a2e0e8f4eee6f341",
        "returnAll": true,
        "options": {}
      },
      "name": "Query Notion Database",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 1,
      "position": [450, 300],
      "id": "notion-query-node",
      "credentials": {
        "notionApi": {
          "id": "your-notion-credential-id",
          "name": "Notion API"
        }
      },
      "notes": "Using typeVersion 1 for maximum compatibility"
    },
    {
      "parameters": {
        "functionCode": "// Transform Notion pages to Google Sheets format\n// SAFE VERSION: Compatible with older n8n versions\n\nconst items = $input.all();\nconst rows = [];\n\nfor (const item of items) {\n  const page = item.json;\n  const properties = page.properties || {};\n  \n  const row = {\n    notion_id: page.id,\n    notion_url: page.url,\n    created_time: page.created_time,\n    last_edited_time: page.last_edited_time\n  };\n  \n  // Extract property values (basic types only for safety)\n  for (const key in properties) {\n    const prop = properties[key];\n    \n    if (prop.type === 'title' && prop.title && prop.title[0]) {\n      row[key] = prop.title[0].plain_text || '';\n    } else if (prop.type === 'rich_text' && prop.rich_text && prop.rich_text[0]) {\n      row[key] = prop.rich_text[0].plain_text || '';\n    } else if (prop.type === 'select' && prop.select) {\n      row[key] = prop.select.name || '';\n    } else if (prop.type === 'date' && prop.date) {\n      row[key] = prop.date.start || '';\n    } else if (prop.type === 'checkbox') {\n      row[key] = prop.checkbox ? 'TRUE' : 'FALSE';\n    } else if (prop.type === 'number') {\n      row[key] = prop.number || 0;\n    } else if (prop.type === 'url') {\n      row[key] = prop.url || '';\n    }\n  }\n  \n  rows.push(row);\n}\n\nreturn rows.map(r => ({ json: r }));"
      },
      "name": "Transform to Sheets Format",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [650, 300],
      "id": "transform-node",
      "notes": "Using function node (typeVersion 1) for compatibility"
    },
    {
      "parameters": {
        "operation": "clear",
        "sheetId": "YOUR_GOOGLE_SHEET_ID",
        "range": "Sheet1"
      },
      "name": "Clear Existing Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 2,
      "position": [850, 200],
      "id": "clear-sheet-node",
      "credentials": {
