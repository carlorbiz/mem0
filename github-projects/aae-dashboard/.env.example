# .env.example - Environment variable template
# Copy this to .env.local for local development

# === Frontend Configuration ===
VITE_API_URL=https://aae-dashboard-production.up.railway.app/api
VITE_MCP_PROXY_URL=https://your-mcp-proxy-url.manus.computer
VITE_APP_TITLE=AAE Dashboard
VITE_APP_LOGO=/logo.png

# === Development Mode (Local Only) ===
# Set to true to bypass authentication during local development
DEV_MODE=true
DEV_USER_ID=1
DEV_USER_NAME="Your Name"
DEV_USER_EMAIL="you@example.com"

# === Database Configuration ===
# Railway PostgreSQL - Shared with Knowledge Lake API
# Get this from Railway dashboard
DATABASE_URL="postgresql://postgres:PASSWORD@host.railway.app:PORT/railway"

# === JWT Secret ===
# Generate with: openssl rand -base64 32
JWT_SECRET="your-secure-jwt-secret-here"

# === Owner Configuration ===
OWNER_NAME="Your Name"

# === Manus Platform URLs ===
VITE_FRONTEND_FORGE_API_URL="https://api.manus.im"
VITE_OAUTH_PORTAL_URL="https://portal.manus.im"

# === Zapier MCP Endpoint ===
# Get from: https://mcp.zapier.com
ZAPIER_MCP_ENDPOINT="https://mcp.zapier.com/api/mcp/s/YOUR_ENDPOINT_ID/mcp"

# === Google OAuth ===
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"
GOOGLE_CALLBACK_URL="https://your-production-url.com/auth/google/callback"

# === Knowledge Lake API ===
# Railway production URL
KNOWLEDGE_LAKE_URL=https://knowledge-lake-api-production.up.railway.app

# === External API Keys ===
# Get from: https://gamma.app/settings/api
GAMMA_API_KEY="sk-gamma-your-api-key-here"

# Get from: https://docsautomator.com/api-keys
DOCSAUTOMATOR_API_KEY="your-docsautomator-api-key-here"
